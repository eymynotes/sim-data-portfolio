    def Scope "_materials"
    {
        def Material "WoodenCrate1" (
            prepend apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token colorSpace:name = "lin_rec709_scene"
            token outputs:surface.connect = </WoodenCrate/_materials/WoodenCrate1/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "WoodenCrate1"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor.connect = </WoodenCrate/_materials/WoodenCrate1/Image_Texture.outputs:rgb>
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic.connect = </WoodenCrate/_materials/WoodenCrate1/Image_Texture_002.outputs:r>
                normal3f inputs:normal.connect = </WoodenCrate/_materials/WoodenCrate1/Image_Texture_003.outputs:rgb>
                float inputs:opacity = 1
                float inputs:roughness.connect = </WoodenCrate/_materials/WoodenCrate1/Image_Texture_001.outputs:r>
                float inputs:specular = 0.5
                token outputs:surface
            }

            def Shader "Image_Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/4k_WoodenCrate1_BaseColor.jpg@
                float2 inputs:st.connect = </WoodenCrate/_materials/WoodenCrate1/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "uvmap"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Image_Texture_002"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/4k_WoodenCrate1_Metallic.jpg@
                float2 inputs:st.connect = </WoodenCrate/_materials/WoodenCrate1/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "Image_Texture_001"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/4k_WoodenCrate1_Roughness.jpg@
                float2 inputs:st.connect = </WoodenCrate/_materials/WoodenCrate1/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "Image_Texture_003"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/4k_WoodenCrate1_Normal.jpg@
                float2 inputs:st.connect = </WoodenCrate/_materials/WoodenCrate1/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }
