#usda 1.0
(
    defaultPrim = "world"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "world"
{
    def Cube "Ground"
    {
        double size = 1
        float3 xformOp:scale = (10, 0.1, 10)
        double3 xformOp:translate = (0, -0.05, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "Shelf_0"
    {
        double3 xformOp:translate = (-2, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Body"
        {
            double size = 1
            float3 xformOp:scale = (1, 2, 0.4)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }

    def Xform "Shelf_1"
    {
        double3 xformOp:translate = (0, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Body"
        {
            double size = 1
            float3 xformOp:scale = (1, 2, 0.4)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }

    def Xform "Shelf_2"
    {
        double3 xformOp:translate = (2, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Body"
        {
            double size = 1
            float3 xformOp:scale = (1, 2, 0.4)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }
}

